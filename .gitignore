__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# Secrets and local configuration
.env
.env.*
!.env.example

# Benchmark outputs. Keep ordinary runs private, but publish the exact credential-free
# judge decisions that underpin the frozen held-out calibration reports.
/runs/*
!/runs/heldout-calibration/
/runs/heldout-calibration/*
!/runs/heldout-calibration/judged-a.jsonl
!/runs/heldout-calibration/judged-b.jsonl
!/runs/judge-c-selection/
/runs/judge-c-selection/*
!/runs/judge-c-selection/judge-a.jsonl
!/runs/judge-c-selection/kimi-k3.jsonl
!/runs/judge-c-selection/minimax-m3.jsonl
!/runs/judge-c-selection/glm-5.3-flash.jsonl
!/runs/refusal-calibration/
/runs/refusal-calibration/*
!/runs/refusal-calibration/judged-A.jsonl
!/runs/refusal-calibration/judged-B.jsonl
!/runs/refusal-calibration/judged-C.jsonl
/outputs/
/results.jsonl
/results.manifest.json
/config.local.yaml

# Blind annotation working files (may reveal labels or annotator responses)
/annotation/generated/
/annotation/responses/

# Editor / OS files
.DS_Store
.idea/
.vscode/
